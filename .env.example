# ===========================
# App runtime configuration
# ===========================

# Node auth/admin API
PORT=3011
JWT_SECRET=change-this-to-a-very-strong-secret
INTERNAL_API_KEY=change-this-internal-service-key

# Python backend
NODE_URL=http://127.0.0.1:3011
APP_URL=https://your-domain.com
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=storyweaver

# Optional global fallback key (tenant keys are still supported in DB)
FAL_API_KEY=

# Optional (used by frontend Gemini helper if enabled)
GEMINI_API_KEY=

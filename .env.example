# ============================================================
# StoryWeaver AI – Environment Variables
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك
# cp .env.example .env && nano .env
# ============================================================

# ---------- عام ----------
# عنوان الموقع (يُستخدم في الباك إند)
APP_URL=https://yourdomain.com

# ---------- مفاتيح الأمان ----------
# غيّر هذه القيم بنصوص عشوائية طويلة
JWT_SECRET=change-me-to-a-long-random-string
INTERNAL_API_KEY=change-me-to-another-random-string

# ---------- Node Auth Server ----------
PORT=3011

# ---------- MongoDB ----------
MONGO_URL=mongodb://localhost:27017
DB_NAME=storyweaver

# ---------- Python Backend → Node URL ----------
# عنوان سيرفر Node الداخلي (يتصل به سيرفر Python لفحص الرصيد)
NODE_URL=http://127.0.0.1:3011

# ---------- FAL.AI ----------
# مفتاح FAL الافتراضي (يمكن تعيين مفتاح لكل مستأجر من لوحة الأدمن)
FAL_API_KEY=

# ---------- Gemini (اختياري – للميزات التي تستخدم Gemini في الفرونت) ----------
GEMINI_API_KEY=
